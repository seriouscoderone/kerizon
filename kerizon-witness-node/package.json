{
  "name": "@kerizon/witness-node",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kerizon/witness": "file:../kerizon-witness"
  },
  "devDependencies": {
    "@kerizon/cesr": "file:../cesr",
    "@kerizon/keri-core": "file:../keri-core",
    "@types/node": "^22.15.0",
    "nedb-promises": "^6.2.3",
    "tsup": "^8.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  }
}
